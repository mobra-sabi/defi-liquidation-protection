# DeFi AI Liquidation Protection Protocol - Environment Configuration

# =============================================================================
# DATA COLLECTION
# =============================================================================

# TheGraph API Key (get from https://thegraph.com/studio/)
THEGRAPH_API_KEY=YOUR_API_KEY_HERE

# Aave V3 Subgraph URL
AAVE_V3_SUBGRAPH_URL=https://gateway.thegraph.com/api/YOUR_KEY/subgraphs/id/Cd2gEDVeqnjBn1hSeqFMitw8Q1iiyV9FYUZkLNRcL87g

# =============================================================================
# BLOCKCHAIN (Monad Testnet)
# =============================================================================

MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_WS_URL=wss://testnet-rpc.monad.xyz/ws
CHAIN_ID=10143

# =============================================================================
# EXECUTOR WALLET (TESTNET ONLY - NEVER USE FOR REAL FUNDS)
# =============================================================================

# Generate a new wallet: npx hardhat run scripts/generate-wallet.js
EXECUTOR_PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY
EXECUTOR_ADDRESS=0xYOUR_TESTNET_ADDRESS
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY

# Minimum balance for executor
MIN_EXECUTOR_BALANCE=0.5

# =============================================================================
# DEPLOYED CONTRACTS (Monad Testnet)
# =============================================================================

POSITION_REGISTRY_ADDRESS=0x242Eb426481d3C1C2b635bcC8BF801ebC678a4E9
PROTECTION_EXECUTOR_ADDRESS=0xd5A4caD8e174e09420A9BF51C71A8CA176040C6f
FEE_COLLECTOR_ADDRESS=0x911A050728D684018dAaE15164267e72F52a9A81

# =============================================================================
# AI ENGINE (Currently disabled - using rule-based)
# =============================================================================

ML_ENABLED=false
TIMESFM_GPU_ID=0
XGBOOST_GPU_ID=1
ANOMALY_DETECTION_GPU_ID=2

# Risk thresholds (rule-based)
RISK_THRESHOLD_SAFE=1.30
RISK_THRESHOLD_WARNING=1.15
RISK_THRESHOLD_ALERT=1.05

# =============================================================================
# MONITOR
# =============================================================================

BLOCK_POLL_INTERVAL=5
LOG_LEVEL=INFO

# =============================================================================
# DATA COLLECTION SETTINGS
# =============================================================================

REQUEST_TIMEOUT=60
MAX_RETRIES=5
RATE_LIMIT_DELAY=0.1
BATCH_SIZE=1000
